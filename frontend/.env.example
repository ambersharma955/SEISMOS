# ---- Development (npm run dev) ----
# Vite proxies /api and /health to the backend. Override only if it runs elsewhere.
SEISMOS_BACKEND_URL=http://127.0.0.1:8000

# ---- Production builds ----
# Leave unset when the frontend is served behind the bundled nginx (Docker).
# Set when the frontend is hosted separately (Render Static Site, Netlify, Vercel...).
# Baked in at build time. No trailing slash.
#VITE_API_BASE_URL=https://seismos-api.onrender.com
